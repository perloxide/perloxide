HOLDER $REG{k7}       ADDR1 -> O7 owner=root
HOLDER $REG{k2}       ADDR2 -> O2 owner=root
HOLDER $ARR[0]        ADDR3 -> O9 owner=root
HOLDER {peer} in O3   ADDR4 -> O4 owner=O3
HOLDER {peer} in O4   ADDR5 -> O3 owner=O4
HOLDER {self} in O5   ADDR6 -> O5 owner=O5
HOLDER {child} in O6  ADDR7 -> O7 owner=O6
HOLDER {kid} in O2    ADDR8 -> O8 owner=O2
HOLDER $WEAK          ADDR9 -> O1 owner=weak
HOLDER $REG{k5}       ADDR10 -> O5 owner=root
HOLDER $REG{k1}       ADDR11 -> O1 owner=root
HOLDER $REG{k3}       ADDR12 -> O3 owner=root
HOLDER $REG{k6}       ADDR13 -> O6 owner=root
HOLDER $REG{k4}       ADDR14 -> O4 owner=root
HOLDER $REG{k0}       ADDR15 -> O0 owner=root
DESTROY O0 phase=DESTRUCT
DESTROY O1 phase=DESTRUCT
DESTROY O6 phase=DESTRUCT
DESTROY O3 phase=DESTRUCT
DESTROY O4 phase=DESTRUCT
DESTROY O5 phase=DESTRUCT
DESTROY O8 phase=DESTRUCT
DESTROY O9 phase=DESTRUCT
DESTROY O7 phase=DESTRUCT
DESTROY O2 phase=DESTRUCT
DESTROY GS phase=DESTRUCT
DESTROY L phase=DESTRUCT
