#!/usr/bin/env perl

# perl-conformance: the differential conformance harness for Perl.
#
#   perl-conformance list     CORPUS                    list test ids (file.pl or file.pl@variant)
#   perl-conformance run      CORPUS [--only RE]        run every test on the target version's builds
#   perl-conformance verdict  CORPUS [--only RE]        classify recorded runs; writes RESULTS/VERSION/verdicts.tsv
#   perl-conformance bless    CORPUS [--only RE]        store verdicts and normalized outputs as CORPUS/expected/TEST/VERSION
#   perl-conformance selftest CORPUS [--only RE]        run + verdict, then compare against the target's blessing
#   perl-conformance gaps     CORPUS                    list the tests not yet blessed on the target version
#   perl-conformance check    CORPUS --impl PATH        run an implementation and compare per lane against the target
#   perl-conformance explain  [ID|AREA...|-a] [-v] [--run]
#                                                      print facts.md entries with their evidence resolved to paths;
#                                                      an AREA prefix lists its ids (-v: explains its entries), -a
#                                                      selects every area, no argument lists the areas (-v: every
#                                                      id), and --run also runs the cited probes and cases
#   perl-conformance explain  --grep RE [-v]            one line per entry whose id or text matches; -v prints them in full
#   perl-conformance cite-check FILE...                 verify that every [fact:ID] citation in FILE names an entry
#   perl-conformance table    MODEL[/NAME] expand [--target V]      the full product of a model's factored table at
#                                                      one version (reports/table.tsv, or reports/NAME.tsv)
#   perl-conformance table    MODEL[/NAME] lookup ROW... [--target V]  the record of each product row at one version
#   perl-conformance table    MODEL[/NAME] diff V1 V2   the rows whose records differ between two versions
#   perl-conformance table    MODEL[/NAME] versions     the versions the table holds
#   perl-conformance replay   MODEL[/NAME] [--target V]  replay the model against its table at one version, no perl
#                                                      involved; prints the mismatches (the model's open gaps)
#
# Common options: --target VERSION (default: the newest version in supported-versions; also PERL_CONFORMANCE_TARGET),
# --results DIR (default ./results; runs land in DIR/VERSION), --config FILE (default perl-conformance.conf beside bin/).
#
# Corpus directives, as comment lines anywhere in a test file:
#   # perl-conformance-requires: threads | locale NAME     skip the test on builds that lack the capability;
#                                             a test that requires threads runs in the threaded family
#   # perl-conformance-variant: NAME VAR=VALUE ...         run the file once per variant with extra environment;
#                                             a file with variants has no implicit default run
#   # perl-conformance-timeout: SECONDS

use strict;
use warnings;
use FindBin qw($Bin);
use lib "$Bin/../lib";
use File::Basename qw(basename);
use File::Path qw(make_path remove_tree);
use File::Spec;
use Getopt::Long qw(GetOptionsFromArray);
use Perl::Conformance::Run;
use Perl::Conformance::Normalize;
use Perl::Conformance::Locales;
use Perl::Conformance::Facts;
use Perl::Conformance::Table;
use Text::Wrap ();

# The LOCPATH holding the harness's compiled locales, set at startup; undef when they could not be compiled.
our $LOCPATH;
use Perl::Conformance::Verdict;

# The reference for a supported version is a family of three builds: stock, and the two allocator
# variants.  There are two families, unthreaded (plain) and built with -Dusethreads (threads).  A test
# runs in the plain family unless it requires threads.  Whichever family is the test's reference, its
# runs are recorded under the generic names (stock.seed0.1 and so on), and the other family's stock
# build runs once as the configuration cross-check (xconfig).  Every run, verdict and blessing is per
# version: the target version is selected with --target or PERL_CONFORMANCE_TARGET and defaults to the newest
# line of supported-versions.  A Perl that is not a supported version is never a reference; it is
# run only as an implementation under `check`.
my %FAMILY = (
    plain   => { stock => 'stock',         noreuse => 'noreuse',         descending => 'descending' },
    threads => { stock => 'threads_stock', noreuse => 'threads_noreuse', descending => 'threads_descending' },
);
# The seed0 group, the seed ladder, and the random pair of Verdict.pm.
my @ORACLE_PLAN = (
    [ 'stock',      'seed0',  2 ],
    [ 'stock',      'seed1',  1 ],
    [ 'stock',      'seed2',  1 ],
    [ 'stock',      'seed3',  1 ],
    [ 'stock',      'random', 2 ],
    [ 'noreuse',    'seed0',  1 ],
    [ 'noreuse',    'seed1',  1 ],
    [ 'descending', 'seed0',  1 ],
    [ 'descending', 'seed1',  1 ],
);
my @CROSS_PLAN = (
    [ 'xconfig', 'seed0', 1 ],
);
my @BUILD_KEYS = qw(stock noreuse descending threads_stock threads_noreuse threads_descending);

sub family_of {
    my ($t) = @_;
    return (grep { $_->[0] eq 'threads' } @{ $t->{requires} }) ? 'threads' : 'plain';
}

# The interpreter path for a run name within a test's family; xconfig is the other family's stock.
sub build_path {
    my ($conf, $family, $build) = @_;
    return $conf->{ $FAMILY{ $family eq 'plain' ? 'threads' : 'plain' }{stock} } if $build eq 'xconfig';
    return $conf->{ $FAMILY{$family}{$build} };
}

sub usage {
    die "usage: perl-conformance list|run|verdict|bless|selftest|gaps|check CORPUS [options]\n"
      . "       perl-conformance explain [ID|AREA...|-a] [-v] [--run] | explain --grep RE [-v] | cite-check FILE...\n"
      . "       perl-conformance table MODEL[/NAME] expand|lookup ROW...|diff V1 V2|versions [--target V]\n"
      . "       perl-conformance replay MODEL[/NAME] [--target V]\n";
}

sub slurp {
    my ($path) = @_;
    return '' unless -e $path;
    open my $fh, '<', $path or die "cannot read $path: $!\n";
    local $/;
    my $text = <$fh>;
    return defined $text ? $text : '';
}

sub spew {
    my ($path, $text) = @_;
    open my $fh, '>', $path or die "cannot write $path: $!\n";
    print {$fh} $text;
    close $fh or die "cannot close $path: $!\n";
}

# A blessed channel is refused if any line ends in whitespace.  Editors and git strip trailing whitespace, so a
# blessed output carrying it would be silently corrupted the next time anyone touched the file; the probe is rewritten
# to delimit what it prints instead.
sub spew_blessed {
    my ($path, $text, $id) = @_;
    die "$id: " . basename($path) . " has trailing whitespace; delimit the probe's output instead of blessing it\n"
        if $text =~ /[ \t]+(?:\n|\z)/;
    spew($path, $text);
}

# The supported versions, oldest first, from supported-versions; the last is the default target.
sub supported_versions {
    my @v = grep { length } map { s/^\s+|\s+$//gr } grep { !/^\s*#/ } split /\n/, slurp("$Bin/../supported-versions");
    die "no supported versions listed in supported-versions\n" unless @v;
    return @v;
}

# The config has one [VERSION] section per supported version holding that version's six build paths,
# and a global timeout.  Only the target version's section is loaded; its keys may be overridden by
# PERL_CONFORMANCE_STOCK, PERL_CONFORMANCE_THREADS_STOCK and so on, as may impl and timeout.
sub load_config {
    my ($path, $target) = @_;
    my %conf = (timeout => 60, target => $target);
    my $section = '';
    for my $line (split /\n/, slurp($path)) {
        next if $line =~ /^\s*(#|$)/;
        if ($line =~ /^\s*\[\s*(\S+)\s*\]\s*$/) { $section = $1; next }
        my ($k, $v) = $line =~ /^\s*(\w+)\s*=\s*(.*?)\s*$/ or die "bad config line in $path: $line\n";
        $conf{$k} = $v if $section eq '' || $section eq $target;
    }
    for my $k (@BUILD_KEYS, qw(impl timeout)) {
        $conf{$k} = $ENV{"PERL_CONFORMANCE_" . uc $k} if defined $ENV{"PERL_CONFORMANCE_" . uc $k};
    }
    return \%conf;
}

# Returns a list of tests: { id, file, env, requires => [...], timeout, probe }.
sub discover {
    my ($corpus, $only) = @_;
    opendir my $dh, $corpus or die "cannot open corpus $corpus: $!\n";
    my @files = sort grep { /\.pl\z/ && -f "$corpus/$_" } readdir $dh;
    my @tests;
    for my $name (@files) {
        my $path = File::Spec->rel2abs("$corpus/$name");
        my $text = slurp($path);
        my @requires = map { [ split ' ', $_ ] } $text =~ /^#\s*perl-conformance-requires:\s*(.+?)\s*$/mg;
        my ($timeout) = $text =~ /^#\s*perl-conformance-timeout:\s*(\d+)/m;
        my $probe = $text =~ /__PROBE__/ ? 1 : 0;
        my @variants = $text =~ /^#\s*perl-conformance-variant:\s*(.+?)\s*$/mg;
        my @specs = @variants ? map { my ($v, @kv) = split ' ', $_; [ "$name\@$v", { map { split /=/, $_, 2 } @kv } ] } @variants
                              : ([ $name, {} ]);
        for my $spec (@specs) {
            next if defined $only && $spec->[0] !~ $only;
            push @tests, { id => $spec->[0], file => $path, env => $spec->[1], requires => \@requires, timeout => $timeout, probe => $probe };
        }
    }
    return @tests;
}

my %capability_cache;
sub has_capability {
    my ($perl, $req) = @_;
    my ($kind, @args) = @$req;
    my $key = join "\0", $perl, $kind, @args;
    return $capability_cache{$key} if exists $capability_cache{$key};
    my $ok = 0;
    if ($kind eq 'threads') {
        my $out = `$perl -MConfig -e 'print \$Config{useithreads} ? 1 : 0' 2>/dev/null`;
        $ok = ($out // '') eq '1' ? 1 : 0;
    }
    elsif ($kind eq 'locale') {
        # A locale requirement names one of the harness's own compiled locales (locales/),
        # never a system locale, so a probe runs the same wherever localedef and the glibc i18n
        # sources exist. It is unmet when those are missing (reported once at startup).
        $ok = ($LOCPATH && Perl::Conformance::Locales::provides($args[0] // '')) ? 1 : 0;
    }
    else {
        die "unknown requirement '$kind'\n";
    }
    return $capability_cache{$key} = $ok;
}

# Results live at RESULTS/VERSION/TEST; blessings at CORPUS/expected/TEST/VERSION, so that a test's
# blessings across versions sit together.
sub test_dir {
    my ($results, $id) = @_;
    (my $safe = $id) =~ s/\@/__/g;
    return "$results/$safe";
}

sub expected_dir {
    my ($corpus, $target, $id) = @_;
    (my $safe = $id) =~ s/\@/__/g;
    return "$corpus/expected/$safe/$target";
}

sub read_record {
    my ($prefix) = @_;
    return undef unless -e "$prefix.exit";
    my %r = map { $_ => slurp("$prefix.$_") } qw(stdout stderr fd3 exit);
    return \%r;
}

sub cmd_run {
    my ($conf, $results, @tests) = @_;
    for my $t (@tests) {
        my $dir = test_dir($results, $t->{id});
        remove_tree($dir);
        make_path($dir);
        my $family = family_of($t);
        my @skipped;
        for my $step (@ORACLE_PLAN, @CROSS_PLAN) {
            my ($build, $mode, $count) = @$step;
            my $perl = build_path($conf, $family, $build);
            next unless defined $perl && length $perl && -x $perl;
            if (grep { !has_capability($perl, $_) } @{ $t->{requires} }) {
                push @skipped, $build;
                next;
            }
            for my $n (1 .. $count) {
                Perl::Conformance::Run::run(
                    perl => $perl, file => $t->{file}, prefix => "$dir/$build.$mode.$n", mode => $mode,
                    extra_env => { %{ $t->{env} || {} }, ($LOCPATH ? (LOCPATH => $LOCPATH) : ()) }, probe_lib => ($t->{probe} ? "$Bin/../probe-lib" : undef),
                    timeout => $t->{timeout} // $conf->{timeout},
                );
            }
        }
        my %seen; @skipped = grep { !$seen{$_}++ } @skipped;
        spew("$dir/family", "$family\n");
        spew("$dir/skipped", join("\n", @skipped) . (@skipped ? "\n" : ''));
        printf "ran %-44s%s%s\n", $t->{id}, ($family eq 'threads' ? "  [threads]" : ''),
            (@skipped ? "  (requirements unmet on: @skipped)" : '');
    }
}

sub classify_test {
    my ($results, $t) = @_;
    my $dir = test_dir($results, $t->{id});
    my $family = slurp("$dir/family");
    chomp $family;
    $family = 'plain' unless length $family;
    my %runs;
    for my $name (@Perl::Conformance::Verdict::REQUIRED) {
        my $r = read_record("$dir/$name");
        return ('skipped', { reason => "missing run $name", family => $family }, undef) unless $r;
        $runs{$name} = $r;
    }
    my ($verdict, $detail) = Perl::Conformance::Verdict::classify(\%runs);
    my $x = read_record("$dir/xconfig.seed0.1");
    $detail->{agrees_with_xconfig} = $x ? (Perl::Conformance::Verdict::exact_key($x) eq Perl::Conformance::Verdict::exact_key($runs{'stock.seed0.1'}) ? 1 : 0) : '-';
    $detail->{family} = $family;
    return ($verdict, $detail, \%runs);
}

sub cmd_verdict {
    my ($results, @tests) = @_;
    my @rows;
    my %count;
    for my $t (@tests) {
        my ($verdict, $detail) = classify_test($results, $t);
        $count{$verdict}++;
        my $info = join ' ', map { "$_=$detail->{$_}" } sort keys %$detail;
        push @rows, "$t->{id}\t$verdict\t$info";
        printf "%-46s %-22s %s\n", $t->{id}, $verdict, $info;
    }
    spew("$results/verdicts.tsv", join("\n", @rows) . "\n");
    print "\n", join(', ', map { "$_: $count{$_}" } sort keys %count), "\n";
}

# Expected outputs: the verdict, the family that produced it, and also_lane_b for every test.  For
# a lane-A test, the exact-normalized seed0 channels from stock run 1 and, when present, the
# exact-normalized seed0 channels of the configuration cross-check (xconfig, the other family).  Canonical channels at seed 0 and seed 1 where a comparison uses them: for a lane-B
# test, and for a lane-A test whose output is independent of hash order (also_lane_b).  An
# allocator-sensitive or nondeterministic test records only its verdict, since no channel of it is
# a function of the program.  Nothing recorded here comes from a random-seed run, so blessing the
# same program twice writes the same files.
sub cmd_bless {
    my ($conf, $corpus, $results, @tests) = @_;
    for my $t (@tests) {
        my ($verdict, $detail, $runs) = classify_test($results, $t);
        my $dir = expected_dir($corpus, $conf->{target}, $t->{id});
        remove_tree($dir);
        make_path($dir);
        spew("$dir/verdict", "$verdict\n");
        spew("$dir/family", "$detail->{family}\n");
        if ($runs) {
            spew("$dir/also_lane_b", "$detail->{also_lane_b}\n");
            if ($verdict eq 'lane-A-eligible') {
                my $s = $runs->{'stock.seed0.1'};
                my @exact = Perl::Conformance::Normalize::exact(@{$s}{qw(stdout stderr fd3)});
                spew_blessed("$dir/seed0.$_", shift @exact, $t->{id}) for qw(stdout stderr fd3);
                spew("$dir/seed0.exit", $s->{exit});
            }
            if ($verdict eq 'lane-B-only' || ($verdict eq 'lane-A-eligible' && $detail->{also_lane_b})) {
                for my $mode (qw(seed0 seed1)) {
                    my $r = $runs->{"stock.$mode.1"};
                    my @canon = Perl::Conformance::Normalize::canonical(@{$r}{qw(stdout stderr fd3)});
                    spew_blessed("$dir/canonical.$mode.$_", shift @canon, $t->{id}) for qw(stdout stderr fd3);
                    spew("$dir/canonical.$mode.exit", $r->{exit});
                }
            }
        }
        for my $cross ($verdict eq 'lane-A-eligible' ? qw(xconfig) : ()) {
            my $x = read_record(test_dir($results, $t->{id}) . "/$cross.seed0.1") or next;
            my @exact = Perl::Conformance::Normalize::exact(@{$x}{qw(stdout stderr fd3)});
            spew_blessed("$dir/$cross.seed0.$_", shift @exact, $t->{id}) for qw(stdout stderr fd3);
            spew("$dir/$cross.seed0.exit", $x->{exit});
        }
        printf "blessed %-44s %s\n", $t->{id}, $verdict;
    }
}

sub cmd_selftest {
    my ($conf, $corpus, $results, @tests) = @_;
    my $failures = 0;

    # A channel that differs from its blessed copy is written out as an expected/actual pair, so the
    # report names where to look rather than only that they differ.
    my $diffdir = "$results/selftest-diffs";
    remove_tree($diffdir);
    make_path($diffdir);
    for my $t (@tests) {
        my $dir = expected_dir($corpus, $conf->{target}, $t->{id});
        my $want = slurp("$dir/verdict");
        chomp $want;
        my $want_family = slurp("$dir/family");
        chomp $want_family;
        $want_family = 'plain' unless length $want_family;
        my ($verdict, $detail, $runs) = classify_test($results, $t);
        my @problems;
        push @problems, "verdict $verdict, expected $want" if $verdict ne $want;
        push @problems, "family $detail->{family}, expected $want_family" if $detail->{family} ne $want_family;
        (my $safe = $t->{id}) =~ s/\@/__/g;
        if ($runs && $want eq 'lane-A-eligible') {
            my @exact = Perl::Conformance::Normalize::exact(@{ $runs->{'stock.seed0.1'} }{qw(stdout stderr fd3)});
            for my $ch (qw(stdout stderr fd3)) {
                my $got  = shift @exact;
                my $want = slurp("$dir/seed0.$ch");
                next if $got eq $want;
                spew("$diffdir/$safe.seed0.$ch.expected", $want);
                spew("$diffdir/$safe.seed0.$ch.actual",   $got);
                push @problems, "seed0 $ch differs from expected (see $diffdir/$safe.seed0.$ch.*)";
            }
        }
        if ($runs && -e "$dir/also_lane_b") {
            my $want_b = slurp("$dir/also_lane_b");
            chomp $want_b;
            push @problems, "also_lane_b $detail->{also_lane_b}, expected $want_b" if $detail->{also_lane_b} ne $want_b;
        }

        # Every canonical channel that bless recorded is reproducible, so each one is checked.
        if ($runs) {
            for my $mode (qw(seed0 seed1)) {
                next unless -e "$dir/canonical.$mode.exit";
                my $r = $runs->{"stock.$mode.1"};
                my %c = (exit => $r->{exit});
                @c{qw(stdout stderr fd3)} = Perl::Conformance::Normalize::canonical(@{$r}{qw(stdout stderr fd3)});
                push @problems, compare_channels("canonical $mode", \%c, $dir, "canonical.$mode", $diffdir, $t->{id});
            }
        }
        $failures++ if @problems;
        printf "%-6s %-44s %s\n", (@problems ? 'FAIL' : 'ok'), $t->{id}, join('; ', @problems);
    }
    print $failures ? "\n$failures selftest failure(s)\n" : "\nselftest passed\n";
    return $failures ? 1 : 0;
}

sub compare_channels {
    my ($label, $got, $dir, $prefix, $diffdir, $id) = @_;
    my @bad;
    for my $ch (qw(stdout stderr fd3 exit)) {
        my $want = slurp("$dir/$prefix.$ch");
        next if $got->{$ch} eq $want;
        push @bad, $ch;
        (my $safe = $id) =~ s/\@/__/g;
        spew("$diffdir/$safe.$prefix.$ch.expected", $want);
        spew("$diffdir/$safe.$prefix.$ch.actual", $got->{$ch});
    }
    return @bad ? ("$label: " . join(',', @bad)) : ();
}

sub cmd_check {
    my ($conf, $corpus, $results, @tests) = @_;
    my $impl = $conf->{impl} or die "check needs --impl PATH or impl= in the config\n";
    my $diffdir = "$results/check-diffs";
    remove_tree($diffdir);
    make_path($diffdir);
    my %tally;
    for my $t (@tests) {
        my $edir = expected_dir($corpus, $conf->{target}, $t->{id});
        my $verdict = slurp("$edir/verdict");
        chomp $verdict;
        unless (length $verdict) {
            $tally{UNBLESSED}++;
            printf "%-5s %-44s %-22s %s\n", 'UNBLESSED', $t->{id}, '-', "not blessed on $conf->{target} (see `perl-conformance gaps`)";
            next;
        }
        my @lacks = map { $_->[0] } grep { !has_capability($impl, $_) } @{ $t->{requires} };
        if (@lacks) {
            $tally{SKIP}++;
            printf "%-5s %-44s %-22s %s\n", 'SKIP', $t->{id}, $verdict, "implementation lacks @lacks";
            next;
        }
        my $wdir = test_dir("$results/check", $t->{id});
        remove_tree($wdir);
        make_path($wdir);
        my %got;
        for my $mode (qw(seed0 seed1)) {
            Perl::Conformance::Run::run(
                perl => $impl, file => $t->{file}, prefix => "$wdir/impl.$mode", mode => $mode,
                extra_env => { %{ $t->{env} || {} }, ($LOCPATH ? (LOCPATH => $LOCPATH) : ()) }, probe_lib => ($t->{probe} ? "$Bin/../probe-lib" : undef),
                timeout => $t->{timeout} // $conf->{timeout},
            );
            $got{$mode} = read_record("$wdir/impl.$mode");
        }
        my ($status, @notes);
        if ($verdict eq 'lane-A-eligible' || $verdict eq 'lane-B-only') {
            my @problems;
            if ($verdict eq 'lane-A-eligible') {
                my %e = (exit => $got{seed0}{exit});
                @e{qw(stdout stderr fd3)} = Perl::Conformance::Normalize::exact(@{ $got{seed0} }{qw(stdout stderr fd3)});
                push @problems, compare_channels('lane A seed0 exact', \%e, $edir, 'seed0', $diffdir, $t->{id});
            }
            for my $mode (qw(seed0 seed1)) {
                next if $verdict eq 'lane-A-eligible' && !($mode eq 'seed1' && slurp("$edir/also_lane_b") =~ /^1/);
                my %c = (exit => $got{$mode}{exit});
                @c{qw(stdout stderr fd3)} = Perl::Conformance::Normalize::canonical(@{ $got{$mode} }{qw(stdout stderr fd3)});
                push @problems, compare_channels("lane B $mode canonical", \%c, $edir, "canonical.$mode", $diffdir, $t->{id});
            }
            $status = @problems ? 'FAIL' : 'PASS';
            @notes = @problems;
        }
        elsif ($verdict eq 'allocator-sensitive' || $verdict eq 'perl-nondeterministic') {
            my $bad = grep { $got{$_}{exit} =~ /^(timeout|signal)/ } qw(seed0 seed1);
            $status = $bad ? 'FAIL' : 'SMOKE';
            my ($se, $re) = map { (my $e = $got{$_}{exit}) =~ s/\s+\z//; $e } qw(seed0 seed1);
            @notes = ("no output comparison; seed0 $se, seed1 $re");
        }
        else {
            $status = 'SKIP';
            @notes = ("expected verdict '$verdict'");
        }
        $tally{$status}++;
        printf "%-5s %-44s %-22s %s\n", $status, $t->{id}, $verdict, join('; ', @notes);
    }
    print "\n", join(', ', map { "$_: $tally{$_}" } sort keys %tally), "\n";
    print "diffs in $diffdir\n" if $tally{FAIL};
    return $tally{FAIL} ? 1 : 0;
}

# The tests the target version has no blessing for: the catch-up list for a version added before
# they were.  Closing it is `perl-conformance run` and `perl-conformance bless` with --target and --only.
sub cmd_gaps {
    my ($conf, $corpus, @tests) = @_;
    my @gaps = grep { !-e expected_dir($corpus, $conf->{target}, $_->{id}) . "/verdict" } @tests;
    print "$_->{id}\n" for @gaps;
    printf STDERR "%d of %d tests not blessed on %s\n", scalar @gaps, scalar @tests, $conf->{target};
    return @gaps ? 1 : 0;
}

my $FACTS_ROOT = File::Spec->rel2abs("$Bin/..");

# Loads facts.md and refuses to go on if its form is broken, since every id and citation rests on it.
sub load_facts {
    my $facts = Perl::Conformance::Facts->load("$FACTS_ROOT/facts.md");
    my @problems = $facts->lint;
    print STDERR "$_\n" for @problems;
    die "facts.md has " . scalar(@problems) . " problem(s)\n" if @problems;
    return $facts;
}

# Wraps an entry's text at 120 columns under an indent, never breaking inside a code span.
sub wrap_entry {
    my ($indent, $text) = @_;
    $text =~ s/(`[^`]*`)/ my $c = $1; $c =~ s{ }{\x{1}}g; $c /ge;
    local $Text::Wrap::columns = 121;
    local $Text::Wrap::huge    = 'overflow';
    local $Text::Wrap::unexpand = 0;
    my $out = Text::Wrap::wrap($indent, $indent, $text);
    $out =~ s/\x{1}/ /g;
    $out =~ s/[ \t]+$//mg;
    return "$out\n";
}

# `explain` with no arguments: the areas, each with its prefix and entry count; with --verbose, every id under its area.
sub list_areas {
    my ($facts, $verbose) = @_;
    for my $area ($facts->areas) {
        my $n = @{ $area->{facts} };
        printf "%-56s [%s.*] (%s)\n", $area->{title}, $area->{prefix}, ($n == 0 ? "no entries yet" : $n == 1 ? "1 entry" : "$n entries");
        list_facts($area, 0) if $verbose && $n;
    }
}

# `explain AREA` (a prefix, no dot): the area's ids with versions, under its title unless the caller printed one.
sub list_facts {
    my ($area, $with_title) = @_;
    print "$area->{title}\n" if $with_title;
    print "  (no entries yet)\n" unless @{ $area->{facts} };
    printf "  %-44s [%s]\n", $_->{id}, $_->{versions} for @{ $area->{facts} };
}

# `explain --grep RE`: one line per matching entry, the id and the entry's first sentence cut to the line; --verbose
# prints the matching entries in full instead.
sub grep_facts {
    my ($facts, $pattern, $verbose) = @_;
    my $re = eval { qr/$pattern/i } or die "bad pattern /$pattern/: $@";
    my @hits = $facts->search($re);
    print STDERR scalar(@hits), " matching fact(s)\n";
    return 1 unless @hits;
    return cmd_explain($facts, undef, map { $_->{id} } @hits) if $verbose;
    for my $fact (@hits) {
        my $lead = sprintf "%-44s ", $fact->{id};
        my $summary = Perl::Conformance::Facts->summary($fact);
        my $room = 120 - length $lead;
        $summary = substr($summary, 0, $room - 1) . "\x{2026}" if length $summary > $room;
        print $lead, $summary, "\n";
    }
    return 0;
}

# `explain ID...`: the entry, its Perl source references, and its evidence with every path resolved.  Under --run the
# cited corpus probes and suite cases run on the target's stock build and are compared with the target's blessing, and
# cited research probes run for their output alone.
sub cmd_explain {
    my ($facts, $run, @ids) = @_;
    my $missing = 0;
    for my $id (@ids) {
        my $fact = $facts->fact($id);
        unless ($fact) {
            print STDERR "no fact `$id`\n";
            $missing++;
            next;
        }
        print "$fact->{id} [$fact->{versions}]\n";
        print "area: $fact->{area}{title} (facts.md:$fact->{line})\n\n";
        print wrap_entry('  ', $fact->{text}), "\n";
        my @evidence = $facts->evidence($fact);
        my @source = map { $_->{name} } grep { $_->{kind} eq 'source' } @evidence;
        print "source: ", join(', ', @source), "\n" if @source;
        my @cited = grep { $_->{kind} ne 'source' } @evidence;
        if (@cited) {
            print "evidence:\n";
            for my $e (@cited) {
                my $flag = exists $e->{exists} && !$e->{exists} ? 'MISSING ' : '';
                my $where = $e->{kind} eq 'case' && $e->{path} ? "  ($e->{path})" : '';
                if ($e->{kind} eq 'rows') {
                    my $record = table_record($e->{name});
                    $where = "  $record" if defined $record;
                }
                printf "  %s%-5s %s%s\n", $flag, $e->{kind}, $e->{name}, $where;
            }
        }
        print "\n";
        $missing += run_evidence($run, @cited) if $run;
    }
    return $missing ? 1 : 0;
}

# Runs each runnable piece of evidence on the target's stock build.  A corpus probe is run once in seed0 mode in the
# family its requirements name and compared with the target's blessing the way selftest compares; a suite case is run
# the way the suite's run.sh runs it and compared with its expected file; a research probe is run for its output.
# Returns the number of runs that differ from their blessing.
sub run_evidence {
    my ($run, @cited) = @_;
    my ($conf, $results) = @{$run}{qw(conf results)};
    my $differs = 0;
    for my $e (@cited) {
        next unless $e->{path} && $e->{exists};
        my $path = "$FACTS_ROOT/$e->{path}";
        if ($e->{kind} eq 'case') {
            my ($suite, $name) = $e->{path} =~ m{^(suites/[^/]+)/cases/([^/]+)\.pl\z};
            my $expected = "$FACTS_ROOT/$suite/expected/$conf->{target}/$name.out";
            my $got = `cd "$FACTS_ROOT/$suite/cases" && "$conf->{stock}" "$name.pl" 2>&1; echo "exit=\$?"`;
            my $want = slurp($expected);
            my $same = -e $expected && $got eq $want;
            $differs++ unless $same;
            print "run $e->{path} on $conf->{target} stock: ", (-e $expected ? ($same ? "matches the blessing" : "DIFFERS from $suite/expected/$conf->{target}/$name.out") : "no blessing on $conf->{target}"), "\n";
            print indent_block($got), "\n";
        }
        elsif ($e->{path} =~ m{^probes/corpus/[^/]+\.pl\z}) {
            my $corpus = "$FACTS_ROOT/probes/corpus";
            my $name = basename($e->{path});
            for my $t (grep { basename($_->{file}) eq $name } discover($corpus, undef)) {
                my $family = family_of($t);
                my $perl = build_path($conf, $family, 'stock');
                my @unmet = grep { !has_capability($perl, $_) } @{ $t->{requires} };
                if (@unmet) {
                    print "run $t->{id}: requirements unmet on $conf->{target} $family stock (@{[ map { $_->[0] } @unmet ]})\n\n";
                    next;
                }
                my $dir = test_dir("$results/explain", $t->{id});
                remove_tree($dir);
                make_path($dir);
                Perl::Conformance::Run::run(
                    perl => $perl, file => $t->{file}, prefix => "$dir/stock.seed0.1", mode => 'seed0',
                    extra_env => { %{ $t->{env} || {} }, ($LOCPATH ? (LOCPATH => $LOCPATH) : ()) }, probe_lib => ($t->{probe} ? "$Bin/../probe-lib" : undef),
                    timeout => $t->{timeout} // $conf->{timeout},
                );
                my $r = read_record("$dir/stock.seed0.1");
                my $blessed = expected_dir($corpus, $conf->{target}, $t->{id});
                my $verdict = slurp("$blessed/verdict");
                chomp $verdict;
                my @problems;
                if ($verdict eq 'lane-A-eligible') {
                    my @exact = Perl::Conformance::Normalize::exact(@{$r}{qw(stdout stderr fd3)});
                    for my $ch (qw(stdout stderr fd3)) {
                        my $got = shift @exact;
                        push @problems, "seed0 $ch differs" if $got ne slurp("$blessed/seed0.$ch");
                    }
                }
                elsif (-e "$blessed/canonical.seed0.exit") {
                    my %c = (exit => $r->{exit});
                    @c{qw(stdout stderr fd3)} = Perl::Conformance::Normalize::canonical(@{$r}{qw(stdout stderr fd3)});
                    push @problems, compare_channels('canonical seed0', \%c, $blessed, 'canonical.seed0', $dir, $t->{id});
                }
                $differs++ if @problems;
                my $status = !length $verdict ? "no blessing on $conf->{target}" : @problems ? "DIFFERS from the blessing (@problems)" : "matches the blessing ($verdict)";
                print "run $t->{id} on $conf->{target} $family stock: $status\n";
                for my $ch (qw(stdout stderr fd3)) {
                    next unless length $r->{$ch};
                    print "  [$ch]\n", indent_block($r->{$ch});
                }
                print "  [exit] $r->{exit}\n";
            }
        }
        elsif ($e->{path} =~ /\.pl\z/ && -f $path) {
            my $got = `cd "$FACTS_ROOT/@{[ $e->{path} =~ s{/[^/]*\z}{}r ]}" && "$conf->{stock}" "@{[ basename($e->{path}) ]}" 2>&1; echo "exit=\$?"`;
            print "run $e->{path} on $conf->{target} stock (research probe, no blessing):\n", indent_block($got), "\n";
        }
    }
    return $differs;
}

sub indent_block {
    my ($text) = @_;
    $text =~ s/^/    /mg;
    $text .= "\n" unless $text =~ /\n\z/;
    return $text;
}

# A cited model row's record at the newest version the table holds, from whichever model's factored table has the row;
# undef when none does.  Rows of a model without a factored table are cited by name alone.
my %TABLES;
sub table_record {
    my ($row) = @_;
    for my $path (sort glob "$FACTS_ROOT/models/*/reports/*.tsv") {
        $TABLES{$path} //= Perl::Conformance::Table->load($path);
        my $table = $TABLES{$path};
        my $rec = $table->lookup($row, $table->{versions}[-1]);
        return $rec if defined $rec;
    }
    return undef;
}

# `cite-check FILE...`: every `[fact:ID]` in each file must name an entry.
sub cmd_cite_check {
    my ($facts, @files) = @_;
    usage() unless @files;
    my ($count, $unknown) = (0, 0);
    for my $file (@files) {
        for my $c (Perl::Conformance::Facts->citations(slurp($file))) {
            my ($id, $line) = @$c;
            $count++;
            next if $facts->fact($id);
            print "$file:$line: unknown fact `$id`\n";
            $unknown++;
        }
    }
    printf STDERR "%d citation(s) in %d file(s), %d unknown\n", $count, scalar @files, $unknown;
    return $unknown ? 1 : 0;
}

# A model's factored table by name: `MODEL` is models/MODEL/reports/table.tsv, `MODEL/NAME` is
# models/MODEL/reports/NAME.tsv (a model with several tables names each).
sub model_table_path {
    my ($spec) = @_;
    my ($model, $name) = split m{/}, $spec, 2;
    $name = 'table' unless defined $name && length $name;
    my $path = "$FACTS_ROOT/models/$model/reports/$name.tsv";
    die "no factored table `$spec` ($path)\n" unless -e $path;
    return ($model, $name, $path);
}

# `table MODEL[/NAME] ...`: the factored table (lib/Perl/Conformance/Table.pm), expanded, looked up or diffed.  The
# target version defaults to the newest version the table holds.
sub cmd_table {
    my ($target, $spec, $what, @args) = @_;
    usage() unless defined $spec && defined $what;
    my ($model, $name, $path) = model_table_path($spec);
    my $table = Perl::Conformance::Table->load($path);
    my @versions = @{ $table->{versions} };
    if ($what eq 'versions') {
        print "$_\n" for @versions;
        return 0;
    }
    if ($what eq 'diff') {
        my ($va, $vb) = @args;
        usage() unless defined $va && defined $vb;
        my @d = $table->diff($va, $vb);
        print $table->name($_->[0]), "\t", $_->[1], "\n", "\t", $_->[2], "\n" for @d;
        printf STDERR "%d row(s) differ between %s and %s\n", scalar @d, $va, $vb;
        return 0;
    }
    $target = $versions[-1] unless defined $target && length $target;
    die "the $spec table holds no version $target (it holds @versions)\n" unless grep { $_ eq $target } @versions;
    if ($what eq 'expand') {
        print "# $spec at $target: @{ $table->{axes} }; fields @{ $table->{fields} }\n";
        print join("\t", @$_), "\n" for $table->expand($target);
        return 0;
    }
    if ($what eq 'lookup') {
        usage() unless @args;
        my $missing = 0;
        for my $row (@args) {
            my $rec = $table->lookup($row, $target);
            if (defined $rec) { print "$row\t$rec\n" } else { print STDERR "no row $row at $target\n"; $missing++ }
        }
        return $missing ? 1 : 0;
    }
    usage();
}

# `replay MODEL[/NAME] [--target V]`: runs the model's generator in replay mode against the rows its factored table
# holds at V, with no perl involved, and prints the mismatches -- the model's open gaps at V as the repository records
# them.  The generator is models/MODEL/generators/*_gen.pl, one per model; a model with several tables is told which
# by TABLE.
sub cmd_replay {
    my ($target, $spec) = @_;
    usage() unless defined $spec;
    my ($model, $name, $path) = model_table_path($spec);
    my @gen = glob "$FACTS_ROOT/models/$model/generators/*_gen.pl";
    die "model $model has @{[ scalar @gen ]} generators, not one: @gen\n" unless @gen == 1;
    my $table = Perl::Conformance::Table->load($path);
    $target = $table->{versions}[-1] unless defined $target && length $target;
    local $ENV{REPLAY} = 1;
    local $ENV{TAG} = $target;
    local $ENV{TABLE} = $name;
    local $ENV{MODEL_ROOT} = "$FACTS_ROOT/models/$model";
    system($^X, $gen[0]);
    return $? >> 8;
}

# The target version, its config, and the compiled locales, for every command that runs a Perl.
sub setup_target {
    my ($target, $config, $results) = @_;
    my @supported = supported_versions();
    $target = $supported[-1] unless defined $target && length $target;
    die "$target is not a supported version (supported-versions lists: @supported)\n" unless grep { $_ eq $target } @supported;
    $results = File::Spec->rel2abs($results) . "/$target";
    my $conf = load_config($config, $target);
    $LOCPATH = Perl::Conformance::Locales::compile("$results/locales");
    print STDERR "perl-conformance: compiled locales unavailable ($Perl::Conformance::Locales::WHY); probes that require one are skipped\n" unless $LOCPATH;
    return ($conf, $results);
}

my ($command, @args) = @ARGV;
usage() unless defined $command;
my ($results, $config, $only, $impl, $target, $run, $pattern, $verbose, $all) = ('results', "$Bin/../perl-conformance.conf", undef, undef, $ENV{PERL_CONFORMANCE_TARGET}, 0, undef, 0, 0);
GetOptionsFromArray(\@args, 'results=s' => \$results, 'config=s' => \$config, 'only=s' => \$only, 'impl=s' => \$impl, 'target=s' => \$target, 'run' => \$run, 'grep=s' => \$pattern, 'verbose|v' => \$verbose, 'all|a' => \$all) or usage();
if ($command eq 'explain') {
    # facts.md is UTF-8 and its entries print as text.
    binmode $_, ':encoding(UTF-8)' for \*STDOUT, \*STDERR;
    my $facts = load_facts();
    if (defined $pattern) {
        usage() if @args || $run || $all;
        exit grep_facts($facts, $pattern, $verbose);
    }
    # --all selects every area, as if each were named.
    if ($all) {
        usage() if @args;
        @args = map { $_->{prefix} } grep { @{ $_->{facts} } } $facts->areas;
    }
    if (!@args) {
        list_areas($facts, $verbose);
        exit 0;
    }

    # An argument without a dot is an area prefix and lists that area's ids, or with --verbose explains all of its
    # entries; an argument with a dot is an id and is explained.
    my @areas = grep { !/\./ } @args;
    @args = grep { /\./ } @args;
    my $unknown = 0;
    for my $prefix (@areas) {
        my $area = $facts->area($prefix);
        if (!$area) { print STDERR "no area `$prefix`\n"; $unknown++ }
        elsif ($verbose) { push @args, map { $_->{id} } @{ $area->{facts} } }
        else { list_facts($area, 1) }
    }
    exit($unknown ? 1 : 0) unless @args;
    my $runner;
    if ($run) {
        my ($conf, $res) = setup_target($target, $config, $results);
        make_path($res);
        $runner = { conf => $conf, results => $res };
    }
    exit(cmd_explain($facts, $runner, @args) || $unknown ? 1 : 0);
}
if ($command eq 'cite-check') {
    exit cmd_cite_check(load_facts(), @args);
}
if ($command eq 'table') {
    binmode $_, ':encoding(UTF-8)' for \*STDOUT, \*STDERR;
    exit cmd_table($target, @args);
}
if ($command eq 'replay') {
    exit cmd_replay($target, @args);
}
my $corpus = shift @args;
usage() unless defined $corpus && -d $corpus;
$corpus = File::Spec->rel2abs($corpus);
my $conf;
($conf, $results) = setup_target($target, $config, $results);
$conf->{impl} = $impl if defined $impl;

# Runs change into the test's directory before exec, so a relative implementation path must be
# resolved here.
$conf->{impl} = File::Spec->rel2abs($conf->{impl}) if defined $conf->{impl} && length $conf->{impl};
my @tests = discover($corpus, defined $only ? qr/$only/ : undef);
make_path($results) if $command eq 'run' || $command eq 'selftest' || $command eq 'check';
if    ($command eq 'list')     { print "$_->{id}\n" for @tests }
elsif ($command eq 'run')      { cmd_run($conf, $results, @tests) }
elsif ($command eq 'verdict')  { cmd_verdict($results, @tests) }
elsif ($command eq 'bless')    { cmd_bless($conf, $corpus, $results, @tests) }
elsif ($command eq 'selftest') { cmd_run($conf, $results, @tests); exit cmd_selftest($conf, $corpus, $results, @tests) }
elsif ($command eq 'gaps')     { exit cmd_gaps($conf, $corpus, @tests) }
elsif ($command eq 'check')    { exit cmd_check($conf, $corpus, $results, @tests) }
else                           { usage() }
