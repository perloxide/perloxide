DESTROY O0 phase=DESTRUCT
DESTROY O1 phase=DESTRUCT
HOLDER $ARR[0]        ADDR -> O9 owner=root
HOLDER $REG{k0}       ADDR -> O0 owner=root
HOLDER $REG{k1}       ADDR -> O1 owner=root
HOLDER $REG{k2}       ADDR -> O2 owner=root
HOLDER $REG{k3}       ADDR -> O3 owner=root
HOLDER $REG{k4}       ADDR -> O4 owner=root
HOLDER $REG{k5}       ADDR -> O5 owner=root
HOLDER $REG{k6}       ADDR -> O6 owner=root
HOLDER $REG{k7}       ADDR -> O7 owner=root
HOLDER $WEAK          ADDR -> O1 owner=weak
HOLDER {child} in O6  ADDR -> O7 owner=O6
HOLDER {kid} in O2    ADDR -> O8 owner=O2
HOLDER {peer} in O3   ADDR -> O4 owner=O3
HOLDER {peer} in O4   ADDR -> O3 owner=O4
HOLDER {self} in O5   ADDR -> O5 owner=O5
