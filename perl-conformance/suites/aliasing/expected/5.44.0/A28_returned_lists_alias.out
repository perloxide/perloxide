sort block:      alias
sort bare:       alias
sort subname:    alias
sort subref:     alias
reverse sort:    alias
reverse:         alias
grep block:      alias
grep expr:       alias
map block:       copy
map block (;):   copy
map expr:        copy
list assign:     copy
write via sort:     30 10 20
write via grep:     30 1 20
write via map:      3 1 2
write via map expr: 3 1 2
write via reverse:  30 10 20
exit=0
